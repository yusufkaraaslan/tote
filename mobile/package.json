{
  "name": "tote-mobile",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && cap sync android",
    "android": "npm run sync && cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "simulate": "node scripts/simulate.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.6.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
