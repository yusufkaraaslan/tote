{
  "name": "tote",
  "productName": "Tote",
  "version": "0.5.10",
  "description": "One window for all your LLMs - web apps, native apps and CLI agents organized around workspaces.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": {
    "name": "yusyus",
    "email": "yusufkaraaslan.yk@gmail.com"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "test": "npm run release:check && node scripts/test-build-globs.js && node --test scripts/test-session-discovery.js scripts/test-local-services.js scripts/test-pty-environment.js scripts/test-config.js scripts/test-views.js scripts/test-transport.js scripts/test-diagnostics.js scripts/test-updates.js scripts/test-self-update.js scripts/test-dependency-health.js scripts/test-background-host.js scripts/test-release-preflight.js scripts/test-android-release-policy.js && node scripts/test-layout.js && node scripts/test-scratch.js && node scripts/test-doc.js && node scripts/test-npmfix.js && node scripts/test-remote.js && node scripts/test-watch.js && node scripts/test-devices.js && node scripts/test-clipboard.js && node scripts/test-sidebar.js && node --test mobile/tests/*.test.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:pacman": "electron-builder --linux pacman",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "install:mac": "scripts/install-macos.sh",
    "test:sidebar-ui": "electron scripts/test-sidebar-ui.js",
    "mobile:build": "npm --prefix mobile run sync",
    "mobile:apk": "npm --prefix mobile run apk",
    "test:mobile-ui": "npm --prefix mobile run test:ui",
    "test:terminal-ui": "electron scripts/test-terminal-ui.js",
    "test:layout-sync-ui": "electron scripts/test-layout-sync-ui.js",
    "test:android-signing": "node scripts/test-android-release-signing.js",
    "release:preflight": "node scripts/release-preflight.js",
    "release:check": "node scripts/release-version.js",
    "release:version": "node scripts/release-version.js --write",
    "prepack": "npm run release:check",
    "predist": "npm run release:check",
    "dependencies:report": "node scripts/dependency-health.js",
    "test:provider-ui": "electron scripts/test-provider-ui.js",
    "test:background-ui": "node scripts/test-background-ui.js",
    "host": "node src/host/daemon.js"
  },
  "build": {
    "appId": "com.tote.app",
    "productName": "Tote",
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json",
      "release.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Utility",
      "synopsis": "One window for all your LLMs",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "artifactName": "Tote-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/before-pack.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^6.0.0",
    "node-pty": "^1.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "desktopName": "tote.desktop",
  "overrides": {
    "minimatch@>=7 <11": "11.0.9"
  }
}
